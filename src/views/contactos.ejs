<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Registros de Contactos</title>
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;500&family=Poppins:wght@400;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <link rel="stylesheet" href="/css/table.css">
</head>
<body>
    <div class="payments-container"> <!-- Misma clase contenedora -->
        <div class="payments-header"> <!-- Misma clase header -->
            <h1 class="payments-title">
                <i class="fas fa-users"></i> Registros de Contactos
            </h1>
            <div class="payments-count">Total: <%= contacts.length %></div>
        </div>

        <% if (contacts.length > 0) { %>
            <div class="payments-grid"> <!-- Misma clase grid -->
                <% contacts.forEach((contact, index) => { %>
                    <div class="payment-card" style="animation-delay: <%= index * 0.1 %>s"> <!-- Misma clase card -->
                        <div class="payment-card-header">
                            <h3 class="payment-card-title"><%= contact.nombre %></h3>
                            <span class="payment-card-type">
                                <i class="fas fa-user-tag"></i> Contacto
                            </span>
                        </div>
                        
                        <div class="payment-card-body">
                            <div class="payment-detail">
                                <span class="payment-detail-label">Correo:</span>
                                <span class="payment-detail-value contact-email"><%= contact.email %></span>
                            </div>
                            
                            <div class="payment-detail">
                                <span class="payment-detail-label">Comentario:</span>
                                <span class="payment-detail-value"><%= contact.comentario %></span>
                            </div>
                            
                            <div class="payment-detail">
                                <span class="payment-detail-label">IP:</span>
                                <span class="payment-detail-value contact-ip"><%= contact.ip %></span>
                            </div>
                        </div>
                        
                        <div class="payment-card-footer">
                            <div class="payment-date">
                                <i class="far fa-calendar-alt"></i>
                                <%= new Date(contact.createdAt).toLocaleDateString() %>
                            </div>
                            <div>
                                <i class="far fa-clock"></i>
                                <%= new Date(contact.createdAt).toLocaleTimeString() %>
                            </div>
                        </div>
                    </div>
                <% }); %>
            </div>
        <% } else { %>
            <div class="no-payments">
                <i class="fas fa-inbox"></i>
                <p>No hay registros de contactos disponibles</p>
            </div>
        <% } %>
    </div>
</body>
</html>