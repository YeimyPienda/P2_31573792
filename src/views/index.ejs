<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SeguriHome - Seguridad Inteligente para Hogares</title>
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700&family=Poppins:wght@600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link rel="stylesheet" href="/css/styles.css">
    <script src="/js/alertConfig.js"></script>
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-6PR0JZ8E3L"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config','G-6PR0JZ8E3L');
  </script>
  <style>
      /* --- HAMBURGER STYLES --- */
.hamburger {
    display: none;
    flex-direction: column;
    cursor: pointer;
}

.hamburger .bar {
    height: 4px;
    width: 25px;
    background-color: #000; /* Color negro */
    margin: 4px 0;
    border-radius: 2px;
    transition: 0.4s;
}

/* Mostrar el botón en pantallas pequeñas */
@media (max-width: 768px) {
    .hamburger {
        display: flex;
    }

    .nav-menu {
        display: none;
        flex-direction: column;
        position: absolute;
        top: 70px;
        right: 20px;
        background-color: white;
        box-shadow: 0 0 10px rgba(0,0,0,0.1);
        border-radius: 8px;
        padding: 15px;
        z-index: 99;
    }

    .nav-menu.active {
        display: flex;
    }

    .nav-menu li {
        margin: 10px 0;
        text-align: right;
    }

    .nav-link {
        color: #000; /* Puedes cambiar esto según tu tema */
        font-weight: 500;
    }
}

  </style>
  <script src="https://www.google.com/recaptcha/api.js" async defer></script>
</head>
<body>
    <nav class="navbar">
        <div class="nav-container">
            <a href="/" class="logo">
                <h1>SeguriHome</h1>
                <img src="/img/261.svg" alt="Sistema de seguridad inteligente" class="nav-img">
            </a>
            
            <ul class="nav-menu" id="navMenu">
                <li><a href="#servicios" class="nav-link"><i class="fas fa-shield-alt"></i> Servicios</a></li>
                <li><a href="#tecnologia" class="nav-link"><i class="fas fa-microchip"></i> Tecnología</a></li>
                <li><a href="#testimonios" class="nav-link"><i class="fas fa-comments"></i> Testimonios</a></li>
                <li title="Contacto"><a href="/admin/contacts" class="nav-link"><i class="fas fa-phone"></i> Contacto</a></li>
                <li title="Pagos realizados"><a href="/getPayment" class="nav-link"><i class="fas fa-credit-card"></i> Pagos</a></li>
            </ul>
            
            <div class="hamburger" id="hamburger">
                <span class="bar"></span>
                <span class="bar"></span>
                <span class="bar"></span>
            </div>

        </div>
    </nav>

    <header class="hero">
        <div class="hero-content">
            <div class="hero-text">
                <h2 class="hero-title">Seguridad Integral para tu Hogar</h2>
                <p class="hero-subtitle">Sistemas inteligentes adaptados a tus necesidades</p>
                <button class="hero-cta">Solicitar Cotización</button>
            </div>
            
            <div class="hero-image">
                <img src="/img/password.svg" alt="Sistema de seguridad inteligente" class="hero-img">
            </div>
        </div>
    </header>

    <section id="servicios" class="services-section">
        <h2 class="section-title">Nuestros Servicios Estrella</h2>
        
        <div class="services-grid">

            <article title="Contratar Servicio" class="service-card">
                <div class="service-icon">
                    <i class="fas fa-video"></i>
                </div>
                <h3 class="service-title">Videovigilancia HD</h3>
                <ul class="service-features">
                    <li>Visibilidad nocturna</li>
                    <li>Detección de movimiento</li>
                    <li>Almacenamiento en la nube</li>
                </ul>
            </article>

            <article title="Contratar Servicio" class="service-card">
                <div class="service-icon">
                    <i class="fas fa-bell"></i>
                </div>
                <h3 class="service-title">Sistema de Alarmas</h3>
                <ul class="service-features">
                    <li>Alertas inmediatas</li>
                    <li>Conexión a central</li>
                    <li>Activación remota</li>
                </ul>
            </article>
            <article title="Contratar Servicio" class="service-card">
                <div class="service-icon">
                    <i class="fas fa-mobile-screen"></i> <!-- Icono de smartphone moderno -->
                </div>
                <h3 class="service-title">Acceso Multiplataforma</h3>
                <ul class="service-features">
                    <li>Control desde cualquier dispositivo</li>
                    <li>Compatibilidad total iOS/Android</li>
                    <li>Interfaz web responsive</li>
                    <li>Sincronización en tiempo real</li>
                </ul>
            </article>

            <article title="Contratar Servicio" class="service-card">
                <div class="service-icon">
                    <i class="fas fa-mobile-alt"></i>
                </div>
                <h3 class="service-title">Control Remoto</h3>
                <ul class="service-features">
                    <li>App móvil integrada</li>
                    <li>Notificaciones en tiempo real</li>
                    <li>Acceso desde cualquier dispositivo</li>
                </ul>
            </article>
            <div class="stat-card">
                <i class="fas fa-shield-alt stat-icon"></i>
                <h3 class="stat-number">1500+</h3>
                <p class="stat-text">Hogares Protegidos</p>
            </div>
            
            <div class="stat-card">
                <i class="fas fa-clock stat-icon"></i>
                <h3 class="stat-number">24/7</h3>
                <p class="stat-text">Monitoreo Continuo</p>
            </div>
        </div>
    </section>

    <section id="tecnologia" class="tech-section">
        <h2 class="section-title">Tecnología Profesional</h2>
        
        <div class="tech-grid">
            <div class="tech-card">
                <div class="tech-icon">
                    <i class="fas fa-video"></i>
                </div>
                <h3 class="tech-title">Cámaras 4K</h3>
                <ul class="tech-features">
                    <li>Resolución Ultra HD</li>
                    <li>Visibilidad Nocturna</li>
                    <li>Detección de Movimiento</li>
                </ul>
            </div>

            <div class="tech-card">
                <div class="tech-icon">
                    <i class="fas fa-microchip"></i>
                </div>
                <h3 class="tech-title">Sensores Inteligentes</h3>
                <ul class="tech-features">
                    <li>Detección de Humo</li>
                    <li>Sensor de Inundación</li>
                    <li>Alerta de Cristal Roto</li>
                </ul>
            </div>

            <div class="tech-card">
                <div class="tech-icon">
                    <i class="fas fa-wifi"></i>
                </div>
                <h3 class="tech-title">Redes Seguras</h3>
                <ul class="tech-features">
                    <li>Routers Blindados</li>
                    <li>Cifrado Militar</li>
                    <li>Protección contra Hackeos</li>
                </ul>
            </div>

            <div class="tech-card">
                <div class="tech-icon">
                    <i class="fas fa-lock"></i>
                </div>
                <h3 class="tech-title">Cerraduras Digitales</h3>
                <ul class="tech-features">
                    <li>Reconocimiento Facial</li>
                    <li>Huella Digital</li>
                    <li>Control por App</li>
                </ul>
            </div>
        </div>
    </section>

    <section id="testimonios" class="testimonials-section">
        <h2 class="section-title">Lo que dicen nuestros clientes</h2>
        
        <div class="testimonials-carousel">
            <article class="testimonial-card">
                <div class="client-info">
                    <div class="client-avatar">
                        <i class="fas fa-user"></i>
                    </div>
                    <h4 class="client-name">Familia González</h4>
                    <div class="client-rating">
                        <i class="fas fa-star"></i>
                        <i class="fas fa-star"></i>
                        <i class="fas fa-star"></i>
                        <i class="fas fa-star"></i>
                        <i class="fas fa-star"></i>
                    </div>
                </div>
                <p class="testimonial-text">"Desde que instalamos el sistema, nuestra tranquilidad aumentó un 100%"</p>
            </article>
        </div>
    </section>

    <section id="contacto" class="contact-section">
        <div class="contact-container">
            <div class="contact-info">
                <h2 class="section-title">Contáctanos</h2>
                
                <div class="info-item">
                    <i class="fas fa-map-marker-alt"></i>
                    <p>San Juan de los Morros, Guárico</p>
                </div>
                
                <div class="info-item">
                    <i class="fas fa-phone"></i>
                    <p>+58 424-1234567</p>
                </div>
                
                <div class="info-item">
                    <i class="fas fa-envelope"></i>
                    <p>contacto@segurihome.com</p>
                </div>
            </div>

            <form id='formulario' class="contact-form">
                <div class="form-group">
                    <input type="text" placeholder="Nombre Completo" required name='nombre' id='nombre'>
                </div>
                
                <div class="form-group">
                    <input type="email" placeholder="Correo Electrónico" required id='email' name='email'>
                </div>
                
                <div class="form-group">
                    <textarea rows="5" placeholder="Tu Mensaje..." required id='comentario' name='comentario'></textarea>
                </div>

                <!-- reCAPTCHA -->
                <div class="g-recaptcha" data-sitekey="<%=sitioKey%>"></div>
                
                <button type="submit" class="submit-btn">Enviar Mensaje</button>
            </form>
        </div>
    </section>

    <footer class="main-footer">
        <div class="footer-content">
            <div class="footer-section">
                <h4>SeguriHome</h4>
                <nav class="footer-nav">
                    <a href="#servicios">Servicios</a>
                    <a href="#tecnologia">Tecnología</a>
                </nav>
            </div>
            
            <div class="footer-section">
                <h4>Legal</h4>
                <nav class="footer-nav">
                    <a href="#">Términos de Servicio</a>
                    <a href="#">Política de Privacidad</a>
                </nav>
            </div>
            
            <div class="footer-section">
                <h4>Conéctate</h4>
                <div class="social-links">
                    <a href="#"><i class="fab fa-facebook"></i></a>
                    <a href="#"><i class="fab fa-instagram"></i></a>
                    <a href="#"><i class="fab fa-whatsapp"></i></a>
                </div>
            </div>
        </div>
        
        <div class="footer-copyright">
            <p>© 2025 SeguriHome. Todos los derechos reservados.</p>
        </div>
    </footer>
    <script>
        // Hamburger Menu Toggle
document.addEventListener('DOMContentLoaded', () => {
    const hamburger = document.getElementById('hamburger');
    const navMenu = document.getElementById('navMenu');

    hamburger.addEventListener('click', () => {
        navMenu.classList.toggle('active');
    });
});
    </script>
    <script src='/js/main.js'></script>
    <script src="/js/fetch.js"></script>
    <script src="/js/clickCards.js"></script>
</body>
</html>