<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Registros de Pagos</title>
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;500&family=Poppins:wght@400;600&display=swap" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <link rel="stylesheet" href="/css/table.css">
    <link rel="stylesheet" href="/css/styles.css">
    <style>
        .relative{
            border: 2px solid red;
        }
    </style>
</head>
<body>
     <%- include('partials/nav') %>
      <!-- 🔍 Buscador -->
        <!-- Formulario estilizado -->
<form id="filterForm" class="mb-6 w-full max-w-4xl mx-auto grid grid-cols-1 md:grid-cols-4 gap-4 items-end">
  <input id="searchInput" type="text" placeholder="Buscar por nombre o correo" class="col-span-1 md:col-span-2 px-4 py-2 border rounded-lg w-full" />
  
  <select id="estadoSelect" class="px-4 py-2 border rounded-lg">
    <option value="">Todos los estados</option>
    <option value="aprobado">Aprobado</option>
    <option value="rechazado">Rechazado</option>
    <option value="pendiente">Pendiente</option>
  </select>

  <select id="servicioSelect" class="px-4 py-2 border rounded-lg">
    <option value="">Todos los servicios</option>
    <option value="Suscripción Mensual">Suscripción Mensual</option>
    <option value="Suscripción Anual">Suscripción Anual</option>
    <!-- agrega más según tus servicios -->
  </select>

  <input type="date" id="fechaInicio" class="px-4 py-2 border rounded-lg" />
  <input type="date" id="fechaFin" class="px-4 py-2 border rounded-lg" />

</form>



        <!-- Contenedor dinámico de contactos -->
    <div id="contactsContainer">

    <div class="payments-container">
        <div class="payments-header">
            <h1 class="payments-title">
                <i class="fas fa-credit-card"></i>Registros de Pagos
            </h1>
            <div class="payments-count">Total: <%=datePayments.length%></div>
        </div>

        <% if (datePayments.length > 0) { %>
        <div class="payments-grid">
            <% datePayments.forEach((payment, index) => { %>
            <div class="payment-card" style="animation-delay: <%= index * 0.1 %>s">
                <div class="payment-card-header">
                    <h3 class="payment-card-title"><%= payment.nombreTitular %></h3>
                    <span class="payment-card-type">
                        <% if (['4'].includes(payment.cardNumber.charAt(0))) { %>
                        <i class="fab fa-cc-visa"></i> Visa
                        <% } else if (['5'].includes(payment.cardNumber.charAt(0))) { %>
                        <i class="fab fa-cc-mastercard"></i> Mastercard
                        <% } else if (['3'].includes(payment.cardNumber.charAt(0))) { %>
                        <i class="fab fa-cc-amex"></i> Amex
                        <% } else { %>
                        <i class="fas fa-credit-card"></i> Tarjeta
                        <% } %>
                    </span>
                </div>
                
                <div class="payment-card-body">
                    <div class="payment-detail">
                        <span class="payment-detail-label">Correo:</span>
                        <span class="payment-detail-value contact-email"><%= payment.correo %></span>
                    </div>
                    
                    <div class="payment-detail">
                        <span class="payment-detail-label">Tarjeta:</span>
                        <span class="payment-detail-value payment-card-number">•••• •••• •••• <%= payment.cardNumber.slice(-4) %></span>
                    </div>
                    
                    <div class="payment-detail">
                        <span class="payment-detail-label">Expira:</span>
                        <span class="payment-detail-value payment-card-expiry">
                            <%= payment.expMonth %>/<%= payment.expYear.toString().slice(-2) %>
                        </span>
                    </div>
                    
                    <div class="payment-detail">
                        <span class="payment-detail-label">Moneda:</span>
                        <span class="payment-detail-value payment-card-currency">
                            <% if (payment.currency === 'USD') { %>
                            $ USD
                            <% } else if (payment.currency === 'EUR') { %>
                            € EUR
                            <% } else if (payment.currency === 'GBP') { %>
                            £ GBP
                            <% } else { %>
                            <%= payment.currency %>
                            <% } %>
                        </span>
                    </div>
                </div>

                <div class="payment-detail">
                   <span class="payment-detail-label">Monto:</span>
                   
                   <span class="payment-detail-value payment-card-currency">
                    <%=payment.amount%>
                </span>
            </div>

            <div class="payment-detail">
               <span class="payment-detail-label">Descripcion:</span>
               
               <span >
                <%=payment.descripcion%>
            </span>
        </div>
        <div class="payment-detail">
           <span class="payment-detail-label">Referencia:</span>
           
           <span >
            <%=payment.reference%>
        </span>
    </div>
    
    <div class="payment-card-footer">
        <div class="payment-date">
            <i class="far fa-calendar-alt"></i>
            <%= new Date(payment.createdAt).toLocaleDateString() %>
        </div>
        <div>
            <i class="far fa-clock"></i>
            <%= new Date(payment.createdAt).toLocaleTimeString() %>
        </div>
    </div>
</div>
<% }); %>
</div>
<% } else { %>
<div class="no-payments">
    <i class="far fa-credit-card"></i>
    <p>No hay registros de pagos disponibles</p>
</div>
<% } %>
</div>
</div>
 <%- include('partials/footer') %>
 <script src="/js/filterPayment.js"></script>
</body>
</html>